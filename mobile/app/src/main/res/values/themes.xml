<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI. The window background is the app's navy so launch
         never flashes white before the first frame. -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tabsync_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
